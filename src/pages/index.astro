---
import Base from '../components/Base.astro';
import IngredientCard from '../components/IngredientCard.astro';
import ingredients from '../data/ingredients.json';
const live=ingredients.filter(i=>i.status==='live');const categories=[...new Set(live.map(i=>i.category))];
---
<Base title="CupToGram | Ingredient Cups to Grams Converter" description="Convert cups, tablespoons, and teaspoons to grams for common baking ingredients. Clear measurement notes and practical kitchen tools.">
<main class="wrap"><section class="hero"><span class="eyebrow">A more reliable way to measure</span><h1>From cups to grams.<br/>Without the guesswork.</h1><p class="lede">Ingredient-specific conversions for everyday cooking and baking. Find a quick estimate, learn how to measure it, and get back to your recipe.</p><div class="searchrow"><input id="ingredient-search" type="search" placeholder="Search flour, sugar, butter…" aria-label="Search ingredients"/><button id="search-clear" type="button">Clear</button></div><p id="search-status" class="small muted" aria-live="polite">Search {live.length} ingredients by name or alias.</p></section>
<section class="section"><div class="sectionhead"><h2>Popular ingredient conversions</h2><span class="muted small">Ingredient-specific estimates</span></div><div class="grid" id="ingredient-grid">{live.map(ingredient=><IngredientCard ingredient={ingredient}/>)}</div></section>
<section class="section"><div class="sectionhead"><h2>Kitchen tools</h2><span class="muted small">Free, no sign-up required</span></div><div class="toolgrid"><a class="card" href="/oven-temperature-converter/"><h3>Oven temperature</h3><p>Convert Fahrenheit and Celsius.</p></a><a class="card" href="/cheat-sheet/"><h3>Printable cheat sheet</h3><p>Keep common gram weights close by.</p></a><a class="card" href="/guides/"><h3>Baking guides</h3><p>Learn measuring methods that work.</p></a><a class="card" href="/methodology/"><h3>Our methodology</h3><p>Understand estimates and variation.</p></a></div></section>
<section class="section card"><h2>Quick conversion calculator</h2><p class="muted">Choose an ingredient, quantity, and measuring system. Results are estimates because ingredients pack differently.</p><div class="calc"><label>Amount<input id="calc-amount" type="text" value="1" inputmode="decimal"/></label><label>Ingredient<select id="calc-ingredient">{live.map(i=><option value={i.slug}>{i.name}</option>)}</select></label><label>Measuring system<select id="calc-system"><option>US</option><option>Metric</option><option>Australia</option></select></label></div><div class="result" aria-live="polite"><span>Estimated weight</span><strong id="calc-result">125 g</strong><span id="calc-detail" class="small">1 US cup of All-Purpose Flour</span></div><p class="small muted">This quick tool converts cups to grams. Ingredient-specific pages provide additional conversions.</p></section>
<section class="section"><h2>Browse categories</h2><div class="toolgrid">{categories.map(category=><a class="card" href={`/category/${category}/`}><h3 style="text-transform:capitalize">{category}</h3><p>{live.filter(i=>i.category===category).length} ingredients</p></a>)}</div></section>
<section class="section content"><h2>Why ingredient-specific weights matter</h2><p>A cup measures volume, while grams measure weight. A cup of flour does not weigh the same as a cup of honey or sugar. Even the same ingredient can vary with particle size, moisture, and how it is packed. Use these values as practical estimates, and choose a kitchen scale when precision is important.</p></section></main>
<script>
// @ts-nocheck
import {parseAmount} from '../lib/parse.mjs';import {convert} from '../lib/convert.mjs';import ingredients from '../data/ingredients.json';
const input=document.querySelector('#ingredient-search'),grid=document.querySelector('#ingredient-grid'),status=document.querySelector('#search-status'),cards=[...grid.children],live=ingredients.filter(x=>x.status==='live');
input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let shown=0;cards.forEach((card,i)=>{const item=live[i],ok=!q||[item.name,...item.aliases].join(' ').toLowerCase().includes(q);card.classList.toggle('hidden',!ok);if(ok)shown++;});status.textContent=shown+' ingredient'+(shown===1?'':'s')+' found.';});
document.querySelector('#search-clear').addEventListener('click',()=>{input.value='';input.dispatchEvent(new Event('input'));input.focus();});
const amount=document.querySelector('#calc-amount'),ing=document.querySelector('#calc-ingredient'),sys=document.querySelector('#calc-system'),result=document.querySelector('#calc-result'),detail=document.querySelector('#calc-detail');
function update(){try{const n=parseAmount(amount.value);if(n===null||n<=0)throw new Error('Enter a number greater than zero.');const item=live.find(x=>x.slug===ing.value),g=convert({amount:n,ingredient:item,conversion:'cup-to-grams',system:sys.value});result.textContent=new Intl.NumberFormat('en-US',{maximumFractionDigits:1}).format(g)+' g';detail.textContent=n+' '+(n===1?'cup':'cups')+' of '+item.name+' · '+sys.value+' cup';}catch(e){result.textContent='Check amount';detail.textContent=e.message;}}
[amount,ing,sys].forEach(el=>el.addEventListener('input',update));update();
</script></Base>