---
import Base from '../components/Base.astro';
import IngredientCard from '../components/IngredientCard.astro';
import ingredients from '../data/ingredients.json';
import { absolute } from '../lib/seo.mjs';
const live=ingredients.filter(i=>i.status==='live');const categories=[...new Set(live.map(i=>i.category))];
const appSchema={'@context':'https://schema.org','@type':'WebApplication',name:'CupToGram',url:absolute('/'),applicationCategory:'UtilitiesApplication',operatingSystem:'Any',description:'Free ingredient-specific cup-to-gram and kitchen measurement converter with source notes and printable references.',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}};
---
<Base title="CupToGram | Cups to Grams by Ingredient" description="Convert cups, tablespoons, and teaspoons to grams with ingredient-specific weights, measuring tips, source notes, and US, metric, and Australian cup options." schema={appSchema}>
<main class="wrap">
<section class="hero">
  <span class="eyebrow">A more reliable way to measure</span>
  <h1><span class="hero-title-main">From cups to grams.</span><br/><span class="hero-title-sub">Without the guesswork.</span></h1>
  <p class="lede">Convert a recipe amount in seconds, or look up a specific ingredient. Clear estimates and measuring tips help you get back to cooking.</p>
</section>

<section class="section card calculator" aria-labelledby="calculator-title">
  <div class="calculator-intro">
    <span class="eyebrow">Start here · Free kitchen tool</span>
    <h2 id="calculator-title">Quick conversion calculator</h2>
    <p>Enter an amount, choose an ingredient, and get an estimated weight in grams. No sign-up required.</p>
  </div>
  <div class="calc">
    <label for="calc-amount">Amount
      <input id="calc-amount" type="text" value="1" inputmode="decimal" autocomplete="off" aria-describedby="amount-help calc-detail" aria-invalid="false"/>
    </label>
    <label for="calc-unit">Recipe unit
      <select id="calc-unit"><option value="cup">Cups</option><option value="tablespoon">Tablespoons (tbsp)</option><option value="teaspoon">Teaspoons (tsp)</option></select>
    </label>
    <label for="calc-ingredient">Ingredient
      <select id="calc-ingredient">{live.map(i=><option value={i.slug}>{i.name}</option>)}</select>
    </label>
    <label for="calc-system">Cup system
      <select id="calc-system"><option>US</option><option>Metric</option><option>Australia</option></select>
    </label>
  </div>
  <p id="amount-help" class="small muted">Fractions accepted: 1/2, 1 1/2, or ½. Choose the cup system used by your recipe.</p>
  <div class="quick-amounts" aria-label="Common amounts">
    <span class="small muted">Quick amounts:</span>
    <button type="button" class="quick-amount" data-amount="1/4">¼</button>
    <button type="button" class="quick-amount" data-amount="1/2">½</button>
    <button type="button" class="quick-amount" data-amount="1">1</button>
    <button type="button" class="quick-amount" data-amount="2">2</button>
  </div>
  <div class="result" aria-live="polite" aria-atomic="true">
    <span class="result-label">Estimated weight</span>
    <strong id="calc-result">120 g</strong>
    <span id="calc-detail" class="small">1 US cup of All-Purpose Flour</span>
  </div>
  <p class="small muted result-note">Weights are estimates. Flour, sugar, and other ingredients can vary with how they are packed. Use a kitchen scale when precision matters.</p>
  <p class="calculator-link"><a href="/ingredients/">Browse all ingredients and measurement notes →</a></p>
</section>

<section class="section">
  <div class="sectionhead"><h2>Popular ingredient conversions</h2><span class="muted small">Ingredient-specific estimates</span></div>
  <div class="searchrow"><label class="visually-hidden" for="ingredient-search">Search ingredients</label><input id="ingredient-search" type="search" placeholder="Try flour, sugar, or butter…" aria-label="Search ingredients"/><button id="search-clear" type="button" class="secondary-button">Clear</button></div>
  <p id="search-status" class="small muted" aria-live="polite">Browse or search {live.length} ingredients by name.</p>
  <div class="grid" id="ingredient-grid">{live.map(ingredient=><IngredientCard ingredient={ingredient}/>)}</div>
  <p id="no-results" class="empty-state hidden">No ingredients found. Try another name or <button id="reset-search" class="text-button" type="button">clear your search</button>.</p>
</section>

<section class="section">
  <div class="sectionhead"><h2>More kitchen tools</h2><span class="muted small">Free · No account needed</span></div>
  <div class="toolgrid"><a class="card" href="/oven-temperature-converter/"><h3>Oven temperature</h3><p>Convert Fahrenheit and Celsius for your recipe.</p></a><a class="card" href="/cheat-sheet/"><h3>Printable cheat sheet</h3><p>Keep common gram weights close by.</p></a><a class="card" href="/guides/"><h3>Baking guides</h3><p>Learn measuring methods that work.</p></a><a class="card" href="/methodology/"><h3>How we calculate</h3><p>Understand estimates and measurement differences.</p></a></div>
</section>

<section class="section">
  <div class="sectionhead"><h2>Browse by category</h2><span class="muted small">Find ingredients faster</span></div>
  <div class="toolgrid">{categories.map(category=><a class="card category-card" href={`/category/${category}/`}><h3 style="text-transform:capitalize">{category}</h3><p>{live.filter(i=>i.category===category).length} ingredients →</p></a>)}</div>
</section>
<section class="section content"><h2>Why ingredient-specific weights matter</h2><p>A cup measures volume, while grams measure weight. A cup of flour does not weigh the same as a cup of honey or sugar. Even the same ingredient can vary with particle size, moisture, and how it is packed. Use these values as practical estimates, and choose a kitchen scale when precision is important.</p><h2>What makes CupToGram useful</h2><ul><li><strong>Ingredient-specific values:</strong> avoid applying one generic grams-per-cup number to every food.</li><li><strong>Clear measuring instructions:</strong> see whether an ingredient should be spooned, leveled, packed, or measured as a liquid.</li><li><strong>Transparent references:</strong> check source notes and the measurement methodology, and treat unverified values as provisional.</li><li><strong>Practical extras:</strong> use a printable cheat sheet, common oven-temperature conversions, and short baking guides without creating an account.</li></ul></section>
</main>
<script>
import {parseAmount} from '../lib/parse.mjs';
import {convert} from '../lib/convert.mjs';
import ingredients from '../data/ingredients.json';
const input=document.querySelector<HTMLInputElement>('#ingredient-search')!,grid=document.querySelector<HTMLElement>('#ingredient-grid')!,status=document.querySelector<HTMLElement>('#search-status')!,cards=[...grid.children],noResults=document.querySelector<HTMLElement>('#no-results')!,live=ingredients.filter(x=>x.status==='live');
function filterIngredients(){const q=input.value.trim().toLowerCase();let shown=0;cards.forEach((card,i)=>{const item=live[i],ok=!q||[item.name,...item.aliases].join(' ').toLowerCase().includes(q);card.classList.toggle('hidden',!ok);if(ok)shown++;});status.textContent=shown+' ingredient'+(shown===1?'':'s')+' found.';noResults.classList.toggle('hidden',shown!==0);}
input.addEventListener('input',filterIngredients);
function clearSearch(){input.value='';filterIngredients();input.focus();}
document.querySelector('#search-clear').addEventListener('click',clearSearch);
document.querySelector('#reset-search').addEventListener('click',clearSearch);
const amount=document.querySelector<HTMLInputElement>('#calc-amount')!,unit=document.querySelector<HTMLSelectElement>('#calc-unit')!,ing=document.querySelector<HTMLSelectElement>('#calc-ingredient')!,sys=document.querySelector<HTMLSelectElement>('#calc-system')!,result=document.querySelector<HTMLElement>('#calc-result')!,detail=document.querySelector<HTMLElement>('#calc-detail')!;
function update(){const parsedAmount=parseAmount(amount.value);amount.setAttribute('aria-invalid',String(parsedAmount===null||parsedAmount<=0));try{const n=parsedAmount;if(n===null||n<=0)throw new Error('Enter an amount greater than zero.');const item=live.find(x=>x.slug===ing.value);if(!item)throw new Error('Choose an ingredient.');const conversion=unit.value==='tablespoon'?'tablespoon-to-grams':unit.value==='teaspoon'?'teaspoon-to-grams':'cup-to-grams';const g=convert({amount:n,ingredient:item,conversion,system:sys.value});result.textContent=new Intl.NumberFormat('en-US',{maximumFractionDigits:2}).format(g)+' g';const amountLabel=unit.value==='tablespoon'?'tbsp':unit.value==='teaspoon'?'tsp':(n===1?'cup':'cups');detail.textContent=n+' '+amountLabel+' of '+item.name+' · '+sys.value+' measures';}catch(e){result.textContent='Check amount';detail.textContent=e.message;}}
[amount,unit,ing,sys].forEach(el=>el.addEventListener('input',update));
document.querySelectorAll<HTMLButtonElement>('.quick-amount').forEach(button=>button.addEventListener('click',()=>{amount.value=button.dataset.amount ?? '1';update();amount.focus();}));
update();
</script>
</Base>