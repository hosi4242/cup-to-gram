---
import Base from '../../components/Base.astro';import IngredientCard from '../../components/IngredientCard.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import ingredients from '../../data/ingredients.json';const categories=[...new Set(ingredients.filter(i=>i.status==='live').map(i=>i.category))];export function getStaticPaths(){const categories=[...new Set(ingredients.filter(i=>i.status==='live').map(i=>i.category))];return categories.map(category=>({params:{category},props:{category}}));}const {category}=Astro.props;const items=ingredients.filter(i=>i.status==='live'&&i.category===category);
---
<Base title={`${category[0].toUpperCase()+category.slice(1)} Conversions | CupToGram`} description={`Browse ingredient-specific cup-to-gram conversions for ${category} and baking recipes.`} path={`/category/${category}/`}><main class="wrap"><Breadcrumbs items={[{label:category[0].toUpperCase()+category.slice(1)}]}/><section class="hero"><span class="eyebrow">Ingredient category</span><h1>{category[0].toUpperCase()+category.slice(1)} conversions</h1><p class="lede">Compare practical cup-to-gram estimates for {category} ingredients. Values depend on preparation and measuring method.</p></section><div class="grid">{items.map(ingredient=><IngredientCard ingredient={ingredient}/>)}</div></main></Base>