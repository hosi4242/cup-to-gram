---
import Base from '../../components/Base.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import {CONVERSIONS} from '../../lib/conversions.mjs';import {convert} from '../../lib/convert.mjs';import {formatAmount} from '../../lib/format.mjs';import ingredients from '../../data/ingredients.json';import {absolute} from '../../lib/seo.mjs';
export function getStaticPaths(){return ingredients.filter(i=>i.status==='live').flatMap(ingredient=>CONVERSIONS.map(conversion=>({params:{ingredient:ingredient.slug,conversion:conversion.slug},props:{ingredient,conversion}})));}
const {ingredient,conversion}=Astro.props;const value=convert({amount:conversion.amount,ingredient,conversion:conversion.slug});const titleAmount=String(conversion.amount);const titleUnit=conversion.from==='cup'?(conversion.amount===1?'Cup':'Cups'):conversion.from==='tbsp'?'Tablespoon'+(conversion.amount===1?'':'s'):conversion.from==='tsp'?'Teaspoon'+(conversion.amount===1?'':'s'):'Grams';const outUnit=conversion.to==='g'?'Grams':conversion.to==='cup'?'Cups':conversion.to==='tbsp'?'Tablespoons':'Ounces';const path=`/${ingredient.slug}/${conversion.slug}/`;const breadcrumbSchema={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:absolute('/')},{'@type':'ListItem',position:2,name:ingredient.name,item:absolute('/'+ingredient.slug+'/')},{'@type':'ListItem',position:3,name:conversion.label,item:absolute(path)}]};const intro=`This ${conversion.label.toLowerCase()} estimate uses a reference weight of ${ingredient.gPerCup} grams per US cup for ${ingredient.name.toLowerCase()}. Actual results can vary with how the ingredient is prepared and measured.`;
---
<Base title={`${titleAmount} ${titleUnit} of ${ingredient.name} in ${outUnit} | CupToGram`} description={`Convert ${titleAmount} ${titleUnit.toLowerCase()} of ${ingredient.name.toLowerCase()} to ${outUnit.toLowerCase()}. See the calculation, measurement method, and source status.`} path={path} schema={breadcrumbSchema}><main class="wrap"><Breadcrumbs items={[{label:ingredient.name,href:`/${ingredient.slug}/`},{label:conversion.label}]}/><section class="hero"><span class="eyebrow">Ingredient conversion</span><h1>{titleAmount} {titleUnit} of {ingredient.name} in {outUnit}</h1><p class="lede">{intro}</p><div class="result"><span>Estimated result</span><strong>{formatAmount(value,2)} {conversion.to}</strong><span class="small">Based on {ingredient.gPerCup} g per US cup · {ingredient.method}</span></div></section>
<section class="section card"><h2>Adjust the amount</h2><div class="calc"><label>Amount<input id="amount" type="text" inputmode="decimal" value={conversion.amount}/></label><label>Conversion<select id="conversion">{CONVERSIONS.map(c=><option value={c.slug} selected={c.slug===conversion.slug}>{c.label}</option>)}</select></label><label>Measuring system<select id="system"><option value="US">US customary</option><option value="Metric">Metric</option><option value="Australia">Australian</option></select></label></div><div class="result" aria-live="polite"><strong id="dynamic-result">{formatAmount(value,2)} {conversion.to}</strong><span id="dynamic-detail" class="small">Updated as you type</span></div></section>
<section class="section content"><h2>How this conversion is calculated</h2><p>{ingredient.name} is estimated at {ingredient.gPerCup} grams per US cup. The calculator scales that reference weight by the requested amount and selected measuring system. This is a practical estimate rather than a laboratory density measurement.</p><h2>Measurement tip</h2><p>{ingredient.note}</p><div class="callout"><strong>For best accuracy:</strong> use a digital kitchen scale, especially for baking recipes where ingredient ratios matter.</div></section>
<section class="section content"><h2>Reference and verification</h2>{ingredient.verified && ingredient.sourceUrl ? <p>The reference weight is marked as source-checked against <a href={ingredient.sourceUrl} target="_blank" rel="noopener noreferrer">{ingredient.sourceName}</a> (last checked {ingredient.sourceChecked}). Weights still vary with brand, preparation, and measuring technique.</p> : <div class="callout"><strong>Provisional estimate:</strong> this value has not yet been verified against a primary ingredient-weight source. Treat the result as approximate and weigh the ingredient for precision.</div>}</section>
<section class="section"><h2>More {ingredient.name.toLowerCase()} conversions</h2><div class="grid">{CONVERSIONS.filter(c=>c.slug!==conversion.slug).map(c=><a class="card" href={`/${ingredient.slug}/${c.slug}/`}><h3>{c.label}</h3><p>{c.amount} {c.from} starting amount</p></a>)}</div></section></main>
<script>
// @ts-nocheck
import {convert} from '../../lib/convert.mjs';import {formatAmount} from '../../lib/format.mjs';import {parseAmount} from '../../lib/parse.mjs';import ingredients from '../../data/ingredients.json';
const amount=document.querySelector('#amount'),conversion=document.querySelector('#conversion'),system=document.querySelector('#system'),result=document.querySelector('#dynamic-result'),detail=document.querySelector('#dynamic-detail');
function update(){try{const n=parseAmount(amount.value);if(n===null||n<=0)throw new Error('Enter a number greater than zero.');const c=conversion.value,item=ingredients.find(i=>i.slug===location.pathname.split('/').filter(Boolean)[0]),v=convert({amount:n,ingredient:item,conversion:c,system:system.value}),to=c.endsWith('grams')?'g':c==='grams-to-cups'?'cup':c==='grams-to-tablespoons'?'tbsp':'oz';result.textContent=formatAmount(v,3)+' '+to;detail.textContent='Estimated value · '+system.options[system.selectedIndex].text;}catch(e){result.textContent='Check amount';detail.textContent=e.message;}}
[amount,conversion,system].forEach(el=>el.addEventListener('input',update));update();
</script></Base>