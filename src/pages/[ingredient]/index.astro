---
import Base from '../../components/Base.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import IngredientCard from '../../components/IngredientCard.astro';import {CONVERSIONS} from '../../lib/conversions.mjs';import ingredients from '../../data/ingredients.json';import {absolute} from '../../lib/seo.mjs';
export function getStaticPaths(){return ingredients.filter(i=>i.status==='live').map(ingredient=>({params:{ingredient:ingredient.slug},props:{ingredient}}));}
const {ingredient}=Astro.props;const breadcrumbSchema={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:absolute('/')},{'@type':'ListItem',position:2,name:ingredient.name,item:absolute('/'+ingredient.slug+'/')}]};const related=ingredient.related.map(slug=>ingredients.find(i=>i.slug===slug)).filter(i=>i?.status==='live');const path=`/${ingredient.slug}/`;
---
<Base title={`${ingredient.name} Cups to Grams and More | CupToGram`} description={`Convert ${ingredient.name.toLowerCase()} between cups, tablespoons, teaspoons, grams, and ounces. Includes measurement tips, source status, and practical estimates.`} path={path} schema={breadcrumbSchema}><main class="wrap"><Breadcrumbs items={[{label:ingredient.name}]}/><section class="hero"><span class="eyebrow">{ingredient.category} conversion guide</span><h1>{ingredient.name}: cups to grams</h1><p class="lede">One US cup of {ingredient.name.toLowerCase()} weighs about <strong>{ingredient.gPerCup} grams</strong> when measured {ingredient.method}.</p><div class="result"><span>1 US cup</span><strong>{ingredient.gPerCup} g</strong><span class="small">Estimated ingredient weight · not a universal density value</span></div></section>
<section class="section"><h2>Choose a conversion</h2><div class="grid">{CONVERSIONS.map(c=><a class="card" style="text-decoration:none;color:inherit" href={`/${ingredient.slug}/${c.slug}/`}><h3>{c.label}</h3><p>Starting amount: {c.amount} {c.from}</p><span class="pill">Open converter →</span></a>)}</div></section>
<section class="section content"><h2>How to measure {ingredient.name.toLowerCase()}</h2><p>{ingredient.note}</p><p>For consistent results, use the same measuring method as the recipe. Volume-to-weight values are estimates; different brands, moisture levels, and preparation methods can change the final weight.</p></section>
<section class="section content"><h2>Reference and verification</h2>{ingredient.verified && ingredient.sourceUrl ? <p>This reference weight is marked as source-checked against <a href={ingredient.sourceUrl} target="_blank" rel="noopener noreferrer">{ingredient.sourceName}</a>. Last checked: {ingredient.sourceChecked}. The source is a practical kitchen reference, not a guarantee that every brand or measuring method will produce the same weight.</p> : <div class="callout"><strong>Provisional estimate:</strong> this value has not yet been verified against a primary ingredient-weight source. Treat it as a rough guide and use a kitchen scale when accuracy matters.</div>}</section>
<section class="section"><h2>Quick reference</h2><div class="tablewrap"><table><thead><tr><th>Measure</th><th>Approximate weight</th></tr></thead><tbody><tr><td>1 cup</td><td>{ingredient.gPerCup} g</td></tr><tr><td>1/2 cup</td><td>{(ingredient.gPerCup/2).toFixed(1)} g</td></tr><tr><td>1/4 cup</td><td>{(ingredient.gPerCup/4).toFixed(1)} g</td></tr><tr><td>1 US tablespoon</td><td>{(ingredient.gPerCup*14.7868/236.588).toFixed(1)} g</td></tr><tr><td>1 US teaspoon</td><td>{(ingredient.gPerCup*4.92892/236.588).toFixed(1)} g</td></tr></tbody></table></div></section>
<section class="section faq"><h2>Frequently asked questions</h2>{ingredient.faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>{related.length>0&&<section class="section"><h2>Related ingredients</h2><div class="grid">{related.map(i=><IngredientCard ingredient={i}/>)}</div></section>}</main></Base>