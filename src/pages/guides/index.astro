---
import Base from '../../components/Base.astro';import {guides} from '../../data/guides.mjs';
---
<Base title="Baking Measurement Guides | CupToGram" description="Practical guides to measuring ingredients, converting grams and cups, and consistent baking." path="/guides/"><main class="wrap"><section class="hero"><span class="eyebrow">Learn the basics</span><h1>Baking measurement guides</h1><p class="lede">Straightforward explanations for ingredient weights, volume measurements, and reliable kitchen habits.</p></section><div class="grid">{guides.map(g=><a class="card" href={`/guides/${g.slug}/`}><h3>{g.title}</h3><p>{g.description}</p><span class="pill">Read guide →</span></a>)}</div></main></Base>