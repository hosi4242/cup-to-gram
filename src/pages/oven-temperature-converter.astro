---
<Base title="Oven Temperature Converter: Fahrenheit to Celsius | CupToGram" description="Convert oven temperatures between Fahrenheit and Celsius with a quick reference table." path="/oven-temperature-converter/"><main class="wrap"><section class="hero"><span class="eyebrow">Free kitchen tool</span><h1>Oven temperature converter</h1><p class="lede">Convert Fahrenheit and Celsius for baking recipes, then check common oven settings at a glance.</p></section><section class="card"><div class="calc"><label>Temperature<input id="temp" type="number" value="350"/></label><label>Convert from<select id="from"><option value="F">Fahrenheit (°F)</option><option value="C">Celsius (°C)</option></select></label><label>Result<strong id="temp-result" style="font-size:1.7rem">177 °C</strong></label></div></section><section class="section"><h2>Common oven temperatures</h2><div class="tablewrap"><table><thead><tr><th>Fahrenheit</th><th>Celsius (rounded)</th><th>Approx. Gas Mark</th></tr></thead><tbody>{rows.map(r=><tr><td>{r.f} °F</td><td>{r.c} °C</td><td>{r.gas}</td></tr>)}</tbody></table></div><p class="small muted">Gas Mark references are approximate; oven conventions vary. Check your recipe and oven manual.</p></section></main><script>
// @ts-nocheck
const t=document.querySelector('#temp'),f=document.querySelector('#from'),o=document.querySelector('#temp-result');function u(){const n=Number(t.value);o.textContent=!t.value||!Number.isFinite(n)?'Enter a temperature':(f.value==='F'?(n-32)*5/9:n*9/5+32).toFixed(0)+' °'+(f.value==='F'?'C':'F')}t.addEventListener('input',u);f.addEventListener('change',u);u();</script></Base>