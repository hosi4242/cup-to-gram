---
import Base from '../components/Base.astro';import ingredients from '../data/ingredients.json';const live=ingredients.filter(i=>i.status==='live');
---
<Base title="Printable Cups to Grams Cheat Sheet | CupToGram" description="Print a kitchen reference chart for cups, half cups, quarter cups, and tablespoons in grams." path="/cheat-sheet/"><main class="wrap"><div class="sectionhead no-print"><div><span class="eyebrow">Kitchen reference</span><h1>Printable cups to grams cheat sheet</h1><p class="lede">A quick reference for common ingredients. Print this page and keep it near your kitchen scale.</p></div><button onclick="window.print()">Print this sheet</button></div><section class="section"><div class="tablewrap"><table><thead><tr><th>Ingredient</th><th>1 cup</th><th>1/2 cup</th><th>1/4 cup</th><th>1 US tbsp</th></tr></thead><tbody>{live.map(i=><tr><td>{i.name}</td><td>{i.gPerCup} g</td><td>{(i.gPerCup/2).toFixed(1)} g</td><td>{(i.gPerCup/4).toFixed(1)} g</td><td>{(i.gPerCup*14.7868/236.588).toFixed(1)} g</td></tr>)}</tbody></table></div><p class="small muted">US cup and tablespoon estimates. Weights are approximate and depend on measuring method, ingredient brand, and moisture.</p></section></main></Base>